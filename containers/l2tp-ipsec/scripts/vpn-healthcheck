#!/bin/sh
# Check tunnel invariants and TCP reachability to the configured private endpoint. Opening
# port 22 requires neither SSH credentials nor a remote command.
set -eu

test -f /run/vpn/ready
ip link show ppp0 | grep -q 'UP'
ip -4 route show default | grep -q 'dev ppp0'
iptables -C OUTPUT -o ppp0 -j ACCEPT
timeout 5 bash -c 'exec 3<>/dev/tcp/$1/$2' -- \
    "${VPN_HEALTH_HOST:?VPN_HEALTH_HOST is required}" "${VPN_HEALTH_PORT:-22}"
