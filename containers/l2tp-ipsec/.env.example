COMPOSE_PROJECT_NAME=example-vpn

# Set a registry image tag/digest, or a local tag when building from source.
VPN_IMAGE=l2tp-ipsec-vpn-sidecar:dev
# VPN_CREDENTIALS_DIR=./secrets

# IPv4 address or DNS name of the L2TP/IPsec server.
VPN_SERVER=203.0.113.10

# Optional comma-separated DNS servers. When omitted, the DNS servers supplied
# by PPP are used. Startup fails if neither source provides DNS servers.
# VPN_DNS=192.0.2.53,192.0.2.54

# Set to no only if the server cannot use IPsec NAT traversal.
VPN_FORCE_ENCAPS=yes

# Add or reorder proposals if the server requires different legacy algorithms.
VPN_IKE_PROPOSALS=aes256-sha256-modp2048,aes256-sha1-modp2048,aes256-sha1-modp1024,aes128-sha1-modp1024,3des-sha1-modp1024
VPN_ESP_PROPOSALS=aes256-sha256,aes256-sha1,aes128-sha1,3des-sha1

# Stable IPv4 address reachable only through the VPN; TCP listener to probe.
VPN_HEALTH_HOST=192.0.2.10
VPN_HEALTH_PORT=22
