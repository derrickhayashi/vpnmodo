#!/usr/bin/env bash
set -eu
umask 077
scenario=$1
base=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
test_dir=$(mktemp -d /tmp/xauth-cli-test.XXXXXX)
trap 'rm -rf "$test_dir"' EXIT
export VPN_MOCK_DIR="$test_dir"
export VPN_PROJECT_DIR="$test_dir/project"
export VPN_COMPOSE_FILE="$VPN_PROJECT_DIR/compose.yaml"
export VPN_TEST_HOST=192.0.2.10 VPN_TEST_PORT=22
export COMPOSE_PROJECT_NAME=vpn-test VPN_IMAGE=test:local VPN_SERVER=203.0.113.10
export VPN_CREDENTIALS_DIR="$VPN_PROJECT_DIR/secrets" VPN_BACKEND_DIR="$base"
export VPN_MOCK_MODE="$scenario"
export PATH="$base/tests/bin:$PATH"
mkdir -p "$VPN_PROJECT_DIR/run" "$VPN_PROJECT_DIR/secrets"
printf 'services: {}\n' >"$VPN_PROJECT_DIR/compose.yaml"
printf 'fake credentials\n' >"$VPN_PROJECT_DIR/secrets/vpn.credentials"
echo stopped >"$test_dir/state"
set +e
"$base/vpn" connect
result=$?
set -e
case $scenario in
success)
    [[ $result == 0 && -e $test_dir/app && ! -e $VPN_PROJECT_DIR/run/email-code ]]
    "$base/vpn" status
    "$base/vpn" disconnect
    [[ $(cat "$test_dir/state") == stopped && ! -e $test_dir/app ]]
    ;;
failure|invalid|cancel)
    [[ $result != 0 && $(cat "$test_dir/state") == stopped && ! -e $test_dir/app && ! -e $VPN_PROJECT_DIR/run/email-code ]]
    ;;
esac
if grep -q '123456' "$test_dir/calls.log"; then echo 'Code leaked into subprocess arguments'; exit 1; fi
printf 'TEST PASSED: %s\n' "$scenario"
