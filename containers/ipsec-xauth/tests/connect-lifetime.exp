#!/usr/bin/env expect -f
# Exercise the real harness with a fake client and a one-second startup timeout.
if {$argc != 1 || [lindex $argv 0] ni {established pending}} {
    puts stderr "Usage: expect tests/connect-lifetime.exp {established|pending}"
    exit 2
}
set scenario [lindex $argv 0]
set env(VPN_SERVER) 203.0.113.10
set env(VPN_IKE_PROPOSALS) aes128-sha1-modp1536
set env(VPN_ESP_PROPOSALS) aes128-sha1-modp1536
set source_file [open [file join [file dirname [info script]] .. connect.exp] r]
set source_text [read $source_file]
close $source_file
set credential_path [exec mktemp /tmp/xauth-vpn-test.XXXXXX]
set credential_file [open $credential_path w]
puts $credential_file "PRE_SHARED_KEY=fake-psk\nPASSWORD=fake-password\nUSERNAME=fake-user"
close $credential_file
rename open real_open
proc open {path args} {
    global credential_path
    if {$path eq "/run/secrets/vpn.credentials"} {
        set channel [real_open $credential_path {*}$args]
        file delete $credential_path
        return $channel
    }
    return [real_open $path {*}$args]
}
set source_text [string map [list "set timeout 90" "set timeout 1" \
    {set route [exec ip -4 route get $env(VPN_SERVER)]} \
    {set route "203.0.113.10 dev eth0 src 172.19.0.2"}] $source_text]
if {$scenario eq "established"} {
    set fake_client {printf 'CHILD_SA cmd{1} established with SPIs fake_i fake_o\n'; sleep 2; exit 0}
} else {
    set fake_client {sleep 2; exit 0}
}
regsub {spawn -noecho charon-cmd[^\n]*} $source_text \
    [list spawn -noecho /bin/sh -c $fake_client] source_text
eval $source_text
