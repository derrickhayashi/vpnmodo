#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077

project_dir=${VPN_PROJECT_DIR:?Set VPN_PROJECT_DIR through scripts/vpn}
compose_file=${VPN_COMPOSE_FILE:?Set VPN_COMPOSE_FILE through scripts/vpn}
test_host=${VPN_TEST_HOST:?Set VPN_TEST_HOST}
test_port=${VPN_TEST_PORT:-22}
started_new=0
code_temp=

die() { printf '%s\n' "$*" >&2; exit 1; }
docker_cmd() { sudo -n docker "$@"; }
compose() { docker_cmd compose --project-directory "$project_dir" -f "$compose_file" "$@"; }
vpn_id() { compose ps -q vpn; }
vpn_state() {
    local id
    id=$(vpn_id)
    if [[ -z $id ]]; then printf 'stopped\n'; return; fi
    docker_cmd inspect --format '{{if .State.Running}}{{if .State.Health}}{{.State.Health.Status}}{{else}}running{{end}}{{else}}stopped{{end}}' "$id" 2>/dev/null || printf 'stopped\n'
}
probe_vpn() { docker_cmd exec "$(vpn_id)" timeout 8 nc -z -w 5 "$test_host" "$test_port" >/dev/null 2>&1; }
diagnostics() { sudo -n tail -n 8 "$project_dir/run/test.log" 2>/dev/null >&2 || true; }
cleanup() {
    local result=$?
    trap - EXIT
    if [[ -n $code_temp ]]; then rm -f -- "$code_temp"; fi
    if (( started_new && result != 0 )); then
        rm -f -- "$project_dir/run/email-code"
        compose down >/dev/null 2>&1 || true
        printf 'Incomplete connection stopped. Run scripts/vpn PROFILE connect to try again.\n' >&2
    fi
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() { printf 'Usage: vpn-backend {connect|status|disconnect}\n'; }
[[ $# == 1 ]] || { usage >&2; exit 2; }
case $1 in connect|status|disconnect) ;; help|--help|-h) usage; exit 0 ;; *) usage >&2; exit 2 ;; esac
[[ -d $project_dir && -f $compose_file ]] || die 'VPN project is missing.'
[[ $test_host =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || die 'Invalid test host.'
[[ $test_port =~ ^[0-9]{1,5}$ ]] && (( 10#$test_port >= 1 && 10#$test_port <= 65535 )) || die 'Invalid test port.'

if [[ $1 != status ]]; then
    mkdir -p "$project_dir/run"
    chmod 700 "$project_dir/run"
    if [[ ${VPN_OPERATION_LOCKED:-} != 1 ]]; then
        exec 9>"$project_dir/run/cli.lock"
    fi
    flock -n 9 || die 'Another VPN operation is active. Cancel it before retrying.'
fi

case $1 in
status)
    state=$(vpn_state)
    if [[ $state != healthy ]]; then
        printf 'VPN: %s\n' "$state"
        exit 1
    fi
    printf 'VPN: connected\n'
    app_id=$(compose ps -q application)
    if [[ -n $app_id ]] && [[ $(docker_cmd inspect --format '{{.State.Running}}' "$app_id") == true ]]; then
        printf 'Application: running\n'
    else
        printf 'Application: stopped\n'
    fi
    if probe_vpn; then
        printf '%s:%s: reachable\n' "$test_host" "$test_port"
    else
        printf '%s:%s: unreachable\n' "$test_host" "$test_port"
        exit 1
    fi
    ;;
disconnect)
    compose down >"$project_dir/run/cli.log" 2>&1 || die 'Could not stop the sidecar; see run/cli.log.'
    rm -f -- "$project_dir/run/email-code"
    printf 'VPN and application disconnected.\n'
    ;;
connect)
    sudo -n true || die 'Passwordless sudo is required on the Linux VPN host.'
    [[ -s $project_dir/secrets/vpn.credentials ]] || die 'Private VPN credentials file is missing.'
    if [[ $(vpn_state) != healthy ]]; then
        [[ -r /dev/tty && -w /dev/tty ]] || die 'An interactive terminal is required for the emailed code.'
        compose down >"$project_dir/run/cli.log" 2>&1 || die 'Could not clear the previous session; see run/cli.log.'
        rm -f -- "$project_dir/run/email-code"
        sudo -n rm -f -- "$project_dir/run/test.log"
        started_new=1
        printf 'Connecting; waiting for the email challenge…\n'
        compose up -d vpn >>"$project_dir/run/cli.log" 2>&1 || die 'Could not start the VPN; see run/cli.log.'
        challenge=0
        deadline=$((SECONDS + 60))
        while (( SECONDS < deadline )); do
            state=$(vpn_state)
            if [[ $state == healthy ]]; then break; fi
            if sudo -n grep -q '^EMAIL_CODE_REQUIRED:' "$project_dir/run/test.log" 2>/dev/null; then
                challenge=1
                break
            fi
            if [[ $state == stopped || $state == unhealthy ]]; then diagnostics; die 'VPN failed before the email challenge.'; fi
            sleep 1
        done
        if (( challenge )); then
            printf 'Use the newest email. You have up to two minutes to enter its code.\n'
            vpn_code=
            if ! IFS= read -r -s -t 120 -p 'Enter emailed code: ' vpn_code </dev/tty; then
                printf '\n' >&2
                die 'Code entry cancelled or timed out.'
            fi
            printf '\n' >&2
            [[ $vpn_code =~ ^[0-9]{4,10}$ ]] || die 'Expected a numeric email code with 4–10 digits.'
            code_temp=$(mktemp "$project_dir/run/.email-code.XXXXXX")
            printf '%s\n' "$vpn_code" >"$code_temp"
            unset vpn_code
            mv -- "$code_temp" "$project_dir/run/email-code"
            code_temp=
            printf 'Code submitted; checking the tunnel…\n'
        elif [[ $(vpn_state) != healthy ]]; then
            diagnostics
            die 'The email challenge did not arrive within one minute.'
        fi
        deadline=$((SECONDS + 90))
        until [[ $(vpn_state) == healthy ]]; do
            state=$(vpn_state)
            if [[ $state == stopped || $state == unhealthy ]] || (( SECONDS >= deadline )); then diagnostics; die 'VPN authentication or tunnel establishment failed.'; fi
            sleep 1
        done
    else
        printf 'VPN is already connected.\n'
    fi
    probe_vpn || die "Tunnel is established, but $test_host:$test_port is unreachable."
    compose up -d application watchdog >>"$project_dir/run/cli.log" 2>&1 || die 'Could not start the application; see run/cli.log.'
    app_id=$(compose ps -q application)
    [[ -n $app_id ]] || die 'Application container is missing.'
    docker_cmd exec "$app_id" timeout 8 nc -z -w 5 "$test_host" "$test_port" >/dev/null 2>&1 || die 'Application connectivity check failed.'
    started_new=0
    printf 'Connected. Application can reach %s:%s.\n' "$test_host" "$test_port"
    ;;
esac
