COMPOSE_PROJECT_NAME=example-vpn
VPN_IMAGE=vpn-sidecar-ipsec-xauth:local
VPN_SERVER=203.0.113.10
VPN_IKE_PROPOSALS=aes128-sha1-modp1536,aes256-sha256-modp1536
VPN_ESP_PROPOSALS=aes128-sha1-modp1536,aes256-sha1-modp1536
# Absolute source and consumer runtime paths on the Linux Docker host.
VPN_BACKEND_DIR=/path/to/vpn-sidecar/containers/ipsec-xauth
VPN_PROJECT_DIR=/srv/example-project/vpn/instances/example
VPN_CREDENTIALS_DIR=/srv/example-project/vpn/instances/example/secrets
