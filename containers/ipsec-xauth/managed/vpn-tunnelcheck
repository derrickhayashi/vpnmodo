#!/bin/sh
set -eu
vpn-enforce check
[ "$(cat /run/vpn/state)" = established ] || exit 1
ip -o xfrm state | tr '\\' ' ' | grep "dst $VPN_SERVER " | grep 'proto esp' | grep -q 'output-mark 0x76706e6d' || exit 1
ip -o xfrm policy | tr '\\' ' ' | grep 'dir out' | grep "dst $VPN_SERVER " | grep -q 'proto esp.*mode tunnel' || exit 1
