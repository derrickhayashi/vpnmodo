#!/usr/bin/expect -f
set timeout 90
log_user 0
exp_internal 0
set f [open /run/secrets/vpn.credentials r]
set data [read $f]
close $f
array set cred {}
foreach line [split $data "\n"] {
    set line [string trimright $line "\r"]
    if {$line eq ""} {continue}
    if {![regexp {^([^=]+)=(.*)$} $line -> key value]} {error "Invalid credentials format"}
    if {[info exists cred($key)]} {error "Duplicate credentials field"}
    set cred($key) $value
}
foreach key {PRE_SHARED_KEY PASSWORD USERNAME} {
    if {![info exists cred($key)] || $cred($key) eq ""} {error "Missing credentials field"}
}
foreach key {VPN_SERVER VPN_IKE_PROPOSALS VPN_ESP_PROPOSALS} {
    if {![info exists env($key)] || $env($key) eq ""} {error "Missing VPN setting: $key"}
}
set route [exec ip -4 route get $env(VPN_SERVER)]
if {![regexp {src ([0-9.]+)} $route -> identity]} {error "Could not determine initial local IKE identity"}
puts "Starting one IKEv1 PSK/XAuth attempt; initial IKE identity is the container IP."
set client_args [list --debug 1 --host $env(VPN_SERVER) --identity $identity --remote-identity %any --xauth-username $cred(USERNAME) --profile ikev1-xauth-psk-am]
foreach proposal [split $env(VPN_IKE_PROPOSALS) ,] {lappend client_args --ike-proposal $proposal}
foreach proposal [split $env(VPN_ESP_PROPOSALS) ,] {lappend client_args --esp-proposal $proposal}
spawn -noecho charon-cmd {*}$client_args
set password_sent 0
set psk_sent 0
set otp_sent 0
expect {
    -exact "Preshared Key: " {
        if {$psk_sent} {puts "Repeated PSK prompt; stopping"; exit 2}
        set psk_sent 1
        send -- "$cred(PRE_SHARED_KEY)\r"
        exp_continue
    }
    -exact "EAP password: " {
        if {$password_sent} {puts "Repeated password prompt; stopping"; exit 2}
        set password_sent 1
        send -- "$cred(PASSWORD)\r"
        puts "Login password submitted; watching for email challenge."
        exp_continue
    }
    -exact "PIN: " {
        if {$otp_sent} {puts "Repeated PIN prompt; stopping"; exit 2}
        puts "EMAIL_CODE_REQUIRED: waiting for a code from the profile controller."
        set deadline [expr {[clock seconds] + 180}]
        while {![file exists /run/control/email-code]} {
            if {[clock seconds] >= $deadline} {puts "Email code wait timed out"; exit 2}
            after 500
        }
        set cf [open /run/control/email-code r]
        set code [string trim [read $cf]]
        close $cf
        file delete /run/control/email-code
        if {![regexp {^[0-9]{4,10}$} $code]} {puts "Invalid email code format"; exit 2}
        set otp_sent 1
        send -- "$code\r"
        unset code
        puts "Email code submitted."
        exp_continue
    }
    -re {([^\r\n]+)\r?\n} {
        set line $expect_out(1,string)
        foreach key {PRE_SHARED_KEY PASSWORD} {
            set line [string map [list $cred($key) "<redacted>"] $line]
        }
        if {[regexp {CHILD_SA .* established with SPIs} $line]} {
            # Keep the authenticated tunnel alive during quiet periods.
            set timeout -1
        }
        puts $line
        exp_continue
    }
    timeout {puts "Connection attempt timed out; stopping"; exit 2}
    eof {
        set result [wait]
        if {[lindex $result 4] eq "CHILDKILLED"} {puts "VPN client terminated by [lindex $result 5]"; exit 2}
        puts "VPN client exited with status [lindex $result 3]."
        exit [lindex $result 3]
    }
}
