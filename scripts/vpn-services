#!/usr/bin/env python3
"""Manage localhost SSH forwards from a trusted, non-secret JSON configuration."""
import argparse
import json
import os
from pathlib import Path
import plistlib
import re
import subprocess
import sys


def load_config(path):
    path = Path(path).resolve()
    config = json.loads(path.read_text())
    if not re.fullmatch(r'[a-z][a-z0-9-]{0,31}', config['name']):
        raise ValueError('name must be 1-32 lowercase letters, digits or hyphens')
    target = config['ssh_target']
    if not isinstance(target, str) or not target or target.startswith('-') or any(c.isspace() for c in target):
        raise ValueError('ssh_target must be an SSH alias without whitespace')
    ssh_config = Path(config['ssh_config']).expanduser()
    if not ssh_config.is_absolute():
        ssh_config = path.parent / ssh_config
    config['ssh_config'] = str(ssh_config.resolve(strict=True))
    forwards = config['forwards']
    if not forwards:
        raise ValueError('at least one forward is required')
    ports = set()
    for forward in forwards:
        for key in ('local_port', 'remote_port'):
            if type(forward[key]) is not int or not 1 <= forward[key] <= 65535:
                raise ValueError(f'{key} must be an integer from 1 to 65535')
        if forward['local_port'] in ports:
            raise ValueError('local ports must be unique')
        ports.add(forward['local_port'])
        host = forward.get('remote_host', '127.0.0.1')
        if not isinstance(host, str) or not re.fullmatch(r'[A-Za-z0-9_.-]+', host):
            raise ValueError('remote_host must be an IPv4 address or hostname')
    return config


def tunnel_args(config, socket):
    args = ['/usr/bin/ssh', '-F', config['ssh_config'], '-M', '-S', str(socket), '-N',
            '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
            '-o', 'ExitOnForwardFailure=yes', '-o', 'ServerAliveInterval=30',
            '-o', 'ServerAliveCountMax=3', '-o', 'LogLevel=VERBOSE']
    for forward in config['forwards']:
        args += ['-L', f"127.0.0.1:{forward['local_port']}:{forward.get('remote_host', '127.0.0.1')}:{forward['remote_port']}"]
    return args + [config['ssh_target']]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('config', type=Path)
    parser.add_argument('action', choices=['start', 'stop', 'restart', 'status', 'foreground', 'supervised', 'command'])
    options = parser.parse_args()
    config = load_config(options.config)
    name = config['name']
    directory = Path.home() / 'Library' / 'Application Support' / 'vpn-sidecar' / name
    # Private directories prevent another local user from substituting the socket.
    if sys.platform == 'darwin':
        socket = directory / 'ssh.sock'
    else:
        directory = Path.home() / '.local' / 'state' / 'vpn-sidecar' / name
        socket = directory / 'ssh.sock'
    if len(os.fsencode(socket)) > 100:
        raise ValueError('control socket path is too long; choose a shorter project name')
    control = ['/usr/bin/ssh', '-F', config['ssh_config'], '-S', str(socket)]
    label = f'com.vpn-sidecar.{name}'
    domain = f'gui/{os.getuid()}'
    plist = directory / f'{label}.plist'
    args = tunnel_args(config, socket)
    if options.action == 'command':
        import shlex
        print(shlex.join(args))
        return 0
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)

    def connected():
        return subprocess.run(control + ['-O', 'check', config['ssh_target']], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    def managed():
        return sys.platform == 'darwin' and subprocess.run(['launchctl', 'print', f'{domain}/{label}'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    def stop():
        if managed():
            subprocess.run(['launchctl', 'bootout', f'{domain}/{label}'], check=True)
        if connected():
            subprocess.run(control + ['-O', 'exit', config['ssh_target']], check=True)
        plist.unlink(missing_ok=True)

    def start():
        if managed() or connected():
            print('Tunnel is already registered or connected.')
            return
        if sys.platform != 'darwin':
            raise ValueError('automatic restart requires macOS; use foreground on other systems')
        log_dir = Path.home() / 'Library' / 'Logs' / 'vpn-sidecar' / name
        log_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        log_path = log_dir / 'tunnel.log'
        log_path.touch(mode=0o600, exist_ok=True)
        settings = {
            'Label': label,
            'ProgramArguments': [sys.executable, str(Path(__file__).resolve()), str(options.config.resolve()), 'supervised'],
            'RunAtLoad': True, 'KeepAlive': True, 'ThrottleInterval': 15,
            'StandardOutPath': str(log_path), 'StandardErrorPath': str(log_path), 'Umask': 0o077,
        }
        with plist.open('wb') as output:
            plistlib.dump(settings, output)
        plist.chmod(0o600)
        subprocess.run(['launchctl', 'bootstrap', domain, str(plist)], check=True)
        print(f'Registered {label}; connection retries every 15 seconds. Log: {log_path}')

    if options.action == 'status':
        print(f'Automatic restart: {managed()}; connected: {connected()}')
    elif options.action == 'stop':
        stop()
    elif options.action == 'restart':
        stop()
        start()
    elif options.action == 'start':
        start()
    else:
        if connected():
            print('Another tunnel is already connected.', file=sys.stderr)
            return 1 if options.action == 'supervised' else 0
        socket.unlink(missing_ok=True)
        return subprocess.call(args)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(2)
