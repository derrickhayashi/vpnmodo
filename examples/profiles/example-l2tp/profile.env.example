# Copy this file to profile.env and fill in your non-secret settings.
VPN_BACKEND=l2tp-ipsec
VPN_SERVER=203.0.113.10
VPN_HEALTH_HOST=192.0.2.10
VPN_HEALTH_PORT=22
VPN_IMAGE=registry.example.com/networking/l2tp-ipsec-vpn-sidecar:VERSION
VPN_DNS=192.0.2.53
# Optional remote execution (omit these fields to run on the current Linux host).
# VPN_SSH_HOST=ubuntu-vpn-host
# VPN_REMOTE_ROOT=/srv/vpn-sidecar/source
# VPN_REMOTE_PROFILES_DIR=/srv/example-project/vpn/profiles

# Shared watcher; recovery mode is chosen automatically from the backend.
# VPN_WATCHDOG_IMAGE=vpn-sidecar-watchdog:local
# VPN_WATCHDOG_INTERVAL=30
# VPN_WATCHDOG_COOLDOWN=300
