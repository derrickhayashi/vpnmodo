# Real XAuth adapter, with shortened lab-only operation/recovery timings.
FROM docker:28.5.1-cli
COPY vpnmodo-controller /usr/local/bin/vpnmodo-controller
ENV VPNMODO_OPERATION_TEST_PROCESS=1 VPNMODO_L2TP_TEST_PROCESS=1 VPNMODO_XAUTH_TEST_PROCESS=1
ENTRYPOINT ["/usr/local/bin/vpnmodo-controller"]
CMD ["serve"]
