#!/bin/sh
set -eu
cd /work
docker build -t vpnmodo-controller:acceptance /opt/lab/production
VPNMODO_ISOLATED_TEST_HOST=1 python3 tests/smoke_controller.py --binary /opt/lab/vpnmodo --image vpnmodo-controller:acceptance
docker build -t vpnmodo-controller:operation-acceptance -f tests/Dockerfile.operations /opt/lab/operations
VPNMODO_ISOLATED_TEST_HOST=1 python3 tests/smoke_controller.py --binary /opt/lab/vpnmodo --image vpnmodo-controller:operation-acceptance --operations
docker build -t vpnmodo-l2tp:dev containers/l2tp-ipsec
docker build -t vpnmodo-lab-gateway:acceptance tests/l2tp-lab
docker pull alpine:3.22
docker build -t vpnmodo-controller:l2tp-acceptance -f tests/Dockerfile.l2tp /opt/lab/operations
VPNMODO_ISOLATED_TEST_HOST=1 python3 tests/smoke_controller.py --binary /opt/lab/vpnmodo --image vpnmodo-controller:l2tp-acceptance --l2tp
echo 'PASS: all isolated Linux acceptance suites'
